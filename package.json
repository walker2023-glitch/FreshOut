{
  "name": "freshout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "check": "node --check src/server.js && node --check src/app.js && node --check src/db.js && node --check src/mailer.js && node --check public/app.js && node --check scripts/qr.js",
    "qr:urls": "node --env-file-if-exists=.env scripts/qr.js --urls",
    "qr:generate": "node --env-file-if-exists=.env scripts/qr.js --generate"
  },
  "dependencies": {
    "express": "^5.1.0",
    "nodemailer": "^7.0.0"
  },
  "devDependencies": {
    "qrcode": "^1.5.4"
  }
}
